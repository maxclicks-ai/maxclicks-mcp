{
  "name": "maxclicks-mcp",
  "version": "2.0.0",
  "description": "The official Model Context Protocol server for the maxclicks Public API. Manage contacts, objects, events, email, webhooks, and workflows from any MCP client.",
  "type": "module",
  "bin": {
    "maxclicks-mcp": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "maxclicks",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor",
    "crm",
    "contacts",
    "email",
    "automation",
    "api"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "sdk:link": "cd ../maxclicks-node && npm run build && npm pack --pack-destination ../maxclicks-mcp",
    "inspector": "node scripts/inspector.js",
    "check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo 'No tests yet' && exit 0",
    "prepublishOnly": "npm run build"
  },
  "author": "maxclicks",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxclicks-ai/maxclicks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maxclicks-ai/maxclicks-mcp/issues"
  },
  "homepage": "https://github.com/maxclicks-ai/maxclicks-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.19.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "maxclicks": "file:maxclicks-1.1.0.tgz",
    "minimist": "^1.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2"
  }
}
