{
  "name": "maxclicks-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Maxclicks API - Enable AI assistants to manage contacts, events, objects, and templates",
  "type": "module",
  "bin": {
    "maxclicks-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "maxclicks",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor",
    "crm",
    "contacts",
    "api",
    "automation",
    "customer-engagement"
  ],
  "scripts": {
    "build": "tsc && chmod +x build/index.js build/server.js",
    "dev": "tsc --watch",
    "inspector": "node scripts/inspector.js",
    "start": "node build/index.js",
    "start:server": "node build/server.js",
    "test": "echo 'No tests yet' && exit 0",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maxclix/maxclicks-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maxclix/maxclicks-mcp/issues"
  },
  "homepage": "https://github.com/maxclix/maxclicks-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@maxclicks/node-sdk": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.19.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "minimist": "^1.2.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.7.2"
  }
}
