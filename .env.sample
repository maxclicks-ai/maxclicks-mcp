# Maxclicks MCP Server OAuth Configuration
MAXCLICKS_API_KEY="your-api-key-here"

# Server Config
PORT=7004
HOST=0.0.0.0
TRANSPORT=httpStream

# OAuth 2.1 Configuration
OAUTH_ENABLED=true
OAUTH_ISSUER=http://localhost:7004
OAUTH_AUTH_ENDPOINT=http://localhost:7004/oauth/authorize
OAUTH_TOKEN_ENDPOINT=http://localhost:7004/oauth/token
OAUTH_JWKS_URI=http://localhost:7004/oauth/jwks
