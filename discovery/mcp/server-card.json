{
  "$schema": "https://static.modelcontextprotocol.io/schemas/v1/server-card.schema.json",
  "name": "ai.maxclicks/mcp",
  "title": "maxclicks",
  "version": "2.0.0",
  "description": "Work with a maxclicks workspace from an MCP client: look up and write contacts and objects, fire events, build and count segments, send prepared templates and broadcasts, drive workflows, and manage webhooks and suppressions.",
  "websiteUrl": "https://docs.maxclicks.ai/ai/mcp",
  "repository": {
    "url": "https://github.com/maxclicks-ai/maxclicks-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://maxclicks.ai/logo-icon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.maxclicks.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Optional. A maxclicks workspace API key, created in Settings, Developers, API keys. Without it, the client signs in with OAuth.",
          "isRequired": false,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "The API key, starting with max_.",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ],
      "supportedProtocolVersions": [
        "2025-11-25",
        "2025-06-18",
        "2025-03-26"
      ]
    }
  ],
  "serverInfo": {
    "name": "maxclicks-mcp",
    "title": "maxclicks",
    "version": "2.0.0"
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://mcp.maxclicks.ai/mcp"
  },
  "capabilities": {
    "tools": {
      "listChanged": false
    }
  },
  "authentication": {
    "required": true,
    "schemes": [
      "oauth2",
      "bearer"
    ]
  }
}
